// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  username      String?   @unique
  bio           String?
  linkedin      String?
  github        String?
  twitter       String?
  role          UserRole  @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  analyses      Analysis[]
  cvUploads     CVUpload[]
  roadmapProgress RoadmapProgress[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  STUDENT
  GRADUATE
  ADMIN
}

model Analysis {
  id               String   @id @default(cuid())
  userId           String
  cvUploadId       String?
  result           Json
  overallReadiness Int
  cvScore          Int
  selectedPath     String?
  createdAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CVUpload {
  id            String   @id @default(cuid())
  userId        String
  filename      String
  fileUrl       String   @default("")
  extractedText String   @db.Text
  fileSize      Int
  uploadedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  usia            Int?
  gender          String?
  sekolah         String?
  jenjang         String?
  lulusan         String?
  jurusan         String?
  nilaiRata       Float?
  hardSkills      String[]
  softSkills      String[]
  minat           String[]
  targetGaji      Int?
  targetPosisi    Json?
  preferensiKerja String?
  kotaTarget      String[]
  sertifikasi     String[]
  pengalaman      Json?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapProgress {
  id        String   @id @default(cuid())
  userId    String
  weekId    String
  taskId    String   // Identifier like "w1-t0"
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}
